# Copy this file to .env and fill it in.
# MongoDB. Local install, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/finance_agent
# Optional, comma-separated DNS servers for Node's resolver to use.
# Only needed if you see "querySrv ECONNREFUSED" connecting to a mongodb+srv://
# URI: Node's bundled resolver (not Windows) sometimes detects the wrong DNS
# server on Windows, even though normal hostname lookups work fine. Leave
# empty unless you hit that error. Example: DNS_SERVERS=8.8.8.8,8.8.4.4
DNS_SERVERS=

# Groq API key from https://console.groq.com/keys
# Leave empty to run without AI, using the basic pattern reader (sample-style invoices only).
GROQ_API_KEY=

# Any Groq chat model that supports JSON mode. See https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# A Groq model that accepts images, for scanned and photographed invoices (JPG, PNG, and
# PDFs with no text layer). See https://console.groq.com/docs/vision for the current list.
GROQ_VISION_MODEL=qwen/qwen3.8-27b
# Local only. Vercel sets its own port: do not set PORT (or DNS_SERVERS) there.
PORT=4000

# Optional, comma-separated. Sites allowed to call the API from a browser, only
# needed when the dashboard is served from a different site than the API.
# Leave empty locally (the Vite dev server proxies /api) and on Vercel (one project,
# same site). Example: CORS_ORIGINS=https://dashboard.example.com,http://localhost:5173
CORS_ORIGINS=
# The business's time zone (IANA name). "Today", due dates, overdue, report months and
# dates in report text follow it, not the server's clock (Vercel runs in UTC).
TIME_ZONE=Australia/Sydney

# The business the agent works for. Used to sign replies to suppliers.
COMPANY_NAME=Meridian Logistics Pty Ltd

# Shows the "Load demo month" and "Reset" buttons, which wipe the data. Only when
# exactly true: leave it unset (or false) for anything beyond a demo.
DEMO_MODE=true

# Optional daily summary email: overdue and due-soon invoices, new exceptions, supplier
# emails waiting for a reply and open bank lines. Sent by GET /api/cron/daily-summary,
# which needs "Authorization: Bearer <CRON_SECRET>" (Vercel's cron job sends it).
# Add ?preview=1 to see the email without sending it.
ALERT_EMAILS=
# The dashboard's address, for the link in the email. Example: https://your-project.vercel.app
APP_URL=
CRON_SECRET=
# Sender. With Resend, use an address on a domain verified in Resend; the default
# onboarding@resend.dev only delivers to the Resend account's own email address.
ALERT_FROM=Finance Operations Agent <onboarding@resend.dev>
# Either Resend (HTTP API)...
RESEND_API_KEY=
# ...or SMTP. Resend is used when both are set. Nothing is sent when neither is.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional shared password for the whole site: pages and API (HTTP Basic auth, any
# user name). Leave empty for no password.
ACCESS_PASSWORD=

# Limit on requests that call Groq or process files (invoices, supplier emails,
# statements, reports, the demo month), per client IP address. Counted in memory,
# so on Vercel each server instance keeps its own count. RATE_LIMIT_MAX=0 turns it off.
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX=30

# Optional: Australian Business Register lookup for supplier ABNs.
# Free GUID from https://abr.business.gov.au/Tools/WebServices
# Without it, ABNs are checked as valid numbers only and shown as "not verified".
ABR_GUID=

# ----- Accounts and sign-in -----
# Everyone signs in with an email and password; roles are set on each account
# (Admin screen). Create the first administrator with:
#   npm run create-admin --prefix server -- --email you@example.com --name "Your Name"
# or, while no account exists, with the setup form and this one-time token
# (remove it once the first administrator exists):
ADMIN_SETUP_TOKEN=
# Hours a sign-in lasts.
SESSION_TTL_HOURS=12
# auto (default): the session cookie is Secure on HTTPS (Vercel). true / false force it.
COOKIE_SECURE=
# Failed sign-ins in a row before an account is locked, and for how long.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Sign-in attempts per IP address per window (0 turns the limit off).
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20

# Earlier typed-name role lists. No longer used for permissions: run
#   npm run migrate --prefix server
# once to give matching accounts these roles, then they can be removed.
REVIEWERS=
APPROVERS=
PAYERS=
# true = the person who approved an invoice cannot also schedule or record its
# payment (compared by account).
SEGREGATE_DUTIES=false

# ----- Payments through the SIMULATED bank -----
# EFT, BPAY and Card payments are sent to a simulated bank by GET /api/cron/tick
# (needs "Authorization: Bearer <CRON_SECRET>", the same CRON_SECRET as above).
# Call it every 5 minutes from an external scheduler: see docs/payments.md.
# Times are in TIME_ZONE.
PAYMENT_CUTOFF=15:00
PAYMENT_DEFAULT_TIME=09:00
# Mon-Fri, Mon-Sun, or a list such as Mon,Tue,Thu.
BUSINESS_DAYS=Mon-Fri
# Comma-separated YYYY-MM-DD. Empty: the built-in Australian national public holidays (2026-2028).
BANK_HOLIDAYS=
# At most this many payments per tick, within this many seconds (Vercel allows 60).
TICK_MAX_JOBS=10
TICK_BUDGET_SECONDS=40
# A tick that dies leaves its job leased this long before another tick takes it over.
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=5
BANK_TIMEOUT_MS=10000

# The simulated bank. No real bank is ever contacted and no money moves.
# Seconds from acceptance to completion (default 20 in demo mode, 120 otherwise).
SIM_BANK_DELAY_SECONDS=
# Completion delay in the "delayed completion" test scenario.
SIM_BANK_DELAYED_SECONDS=600
SIM_BANK_OPENING_BALANCE=250000
# Simulated BSBs must start with this; anything else is refused.
SIM_BANK_BSB_PREFIX=999
SIM_BANK_TEMPORARY_FAILURES=1

# ----- Payment notices to suppliers -----
# Only APP_ENV=production AND SUPPLIER_EMAIL_MODE=live (with RESEND_API_KEY or
# SMTP_HOST) emails a supplier. Otherwise a notice goes to TEST_EMAIL_RECIPIENT
# (if set, with an email service), or stays in the simulated outbox.
APP_ENV=development
SUPPLIER_EMAIL_MODE=outbox
TEST_EMAIL_RECIPIENT=
# Sender for payment notices. Defaults to ALERT_FROM.
SUPPLIER_EMAIL_FROM=
# Policy. These are sample values: agree the real ones with the client's finance team.
# Match score (0-100) at or above which a clean invoice is ELIGIBLE FOR APPROVAL REVIEW.
# It never approves anything: a person always approves.
MATCH_THRESHOLD=85
# Where an invoice without the supplier's ABN goes: review (Needs Review) or hold (On Hold).
MISSING_ABN_POLICY=review
# How far a unit price may differ from the purchase order, in percent.
PRICE_TOLERANCE_PCT=2
# Below this reading confidence (0 to 1), a person reviews the invoice.
MIN_CONFIDENCE=0.8
